# Copy to .env.local for local development (.env*.local is git-ignored).
# Deployments set the same names in the Amplify console instead.
# Every setting is read in src/custom-dashboard/server/config.ts.

# --- required ---
# LightMetrics API the questions are run against.
CD_LM_API_BASE=https://white-v2.lightmetrics.co/llm-chat
CD_LM_ACCESS_TOKEN=
CD_LM_REFERER=https://dashboard.lightmetrics.co/
# The account and fleet every user sees.
CD_CLIENT_ID=
CD_FLEET_ID=
# Chart generation, naming and date-range parsing.
CD_OPENAI_API_KEY=

# --- storage ---
# Local development: leave the S3 settings empty and data is written as JSON
# files under this folder. On Amplify you MUST set CD_S3_BUCKET instead: its
# servers are short-lived and share no disk, so file storage loses saves and
# makes new charts fail. See src/custom-dashboard/server/storage.ts.
CD_DASHBOARD_DATA_DIR=.data
# CD_S3_BUCKET=
# CD_S3_REGION=
# CD_S3_PREFIX=custom-dashboard/

# --- optional (defaults shown) ---
# CD_LM_USER_TIMEZONE=Asia/Calcutta
# CD_VIZ_MODEL=gpt-4o
# CD_UTILITY_MODEL=gpt-4o-mini
# CD_DATERANGE_PICKER_PREFILL=Past 30 days
# CD_USER_NAME=there
# CD_SUGGESTION_TTL_DAYS=7
# CD_UPSTREAM_CONNECT_TIMEOUT=10
# CD_UPSTREAM_READ_TIMEOUT=180
